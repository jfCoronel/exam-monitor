{
  "name": "exam-monitor",
  "version": "0.1.0",
  "description": "PWA para supervisar el foco del navegador de los alumnos durante exámenes presenciales",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "smoke": "node scripts/smoke-test.js",
    "test:rules": "firebase emulators:exec --only database --project demo-foco \"node --test test/\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.31.0"
  }
}
