{
  "name": "exam-monitor",
  "version": "0.4.0",
  "description": "PWA para supervisar el foco del navegador en exámenes presenciales (GitHub Pages + Firebase)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "firebase emulators:exec --project demo-foco --only auth,database \"node scripts/dev-server.js\"",
    "smoke": "firebase emulators:exec --project demo-foco --only auth,database \"node scripts/smoke-test.js\"",
    "test": "firebase emulators:exec --project demo-foco --only database \"node --test 'test/**/*.test.js'\"",
    "deploy:rules": "firebase deploy --only database"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.31.0"
  }
}
